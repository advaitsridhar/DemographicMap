   json: {"odata.metadata": "https://opendata.cbs.nl/ODataApi/OData/70739ned/$metadata#Cbs.OData.WebAPI.DataProperties", "value": [{"odata.type": "Cbs.OData.GeoDimension", "ID": 0, "Position": 0, "ParentID": null, "Type": "GeoDimension", "Key": "RegioS", "Title": "Regio's", "Description": "", "MapYear": null}, {"odata.type": "Cbs.OData.Topic", "ID": 1, "Position": 1, "ParentID": null, "Type": "Topic", "Key": "Begindatum_1", "Title": "Begindatum", "Description": "Datum van ontstaan van de gebieds- of gemeentenaam. Indien ontstaan voor 1830 is de datum op 01 januari 1830 gezet.", "Datatype": "String", "Unit": "datum", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 2, "Position": 2, "ParentID": null, "Type": "Topic", "Key": "Einddatum_2", "Title": "Einddatum", "Description": "Einddatum van de gebieds- of gemeentenaam. Als het gebied nog bestaat dan staat hier niets.", "Datatype": "String", "Unit": "datum", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 3, "Position": 3, "ParentID": null, "Type": "Topic", "Key": "GebiedsOfGemeentecode_3", "Title": "Gebieds- of gemeentecode", "Description": "Tweecijferige gebiedscode of viercijferige gemeentecode, voorafgegaan door twee letters die het type gebied aanduiden (bijvoorbeeld 'PV' voor provincies).\r\n\r\nOok opgenomen zijn:\r\nOpenbaar lichaam Zuidelijke IJsselmeer Polders (GM0996), Buitenland (GM0998) en Niet gemeentelijk ingedeeld (GM0999).\r\n", "Datatype": "String", "Unit": "code", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 4, "Position": 4, "ParentID": null, "Type": "Topic", "Key": "Provincie_4", "Title": "Provincie", "Description": "De namen van provincies.\r\n\r\nVan de gemeenten Leimuiden, Noordoostpolder, Oudewater, Terschelling, Urk (2x), Vianen, Vlieland en Woerden is de provincie gewijzigd.\r\n\r\nWijzigingen van provincie sinds 1830:\r\nLeimuiden overgegaan van Noord-Holland naar Zuid-Holland in 1864\r\nNoordoostpolder overgegaan van Overijssel naar Flevoland op 1 januari 1986\r\nOudewater overgegaan van Zuid-Holland naar Utrecht op 1 september 1970\r\nTerschelling overgegaan van Noord-Holland naar Fryslân op 1 september 1942\r\nUrk overgegaan van Noord-Holland naar Overijssel op 1 april 1950\r\nUrk overgegaan van Overijssel naar Flevoland op 1 januari 1986\r\nVianen overgegaan van Zuid-Holland naar Utrecht op 1 januari 2002\r\nVlieland overgegaan van Noord-Holland naar Fryslân op 1 september 1942\r\nWoerden overgegaan van Zuid-Holland naar Utrecht op 1 januari 1989\r\nBovengenoemde gemeenten zijn in de tabel ingedeeld bij de huidige provincie.", "Datatype": "String", "Unit": "naam", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 5, "Position": 5, "ParentID": null, "Type": "Topic", "Key": "ProvincieAfkorting_5", "Title": "Provincie (afkorting)", "Description": "Afkortingen voor de namen van de provincies:\r\nGr. =  Groningen\r\nF.  =  Fryslân\r\nD.  =  Drenthe\r\nO.  =  Overijssel\r\nFle.=  Flevoland\r\nGld.=  Gelderland\r\nU.  =  Utrecht\r\nNH. =  Noord-Holland\r\nZH. =  Zuid-Holland\r\nZ.  =  Zeeland\r\nNB. =  Noord-Brabant\r\nL.  =  Limburg\r\n\r\nVan de gemeenten Leimuiden, Noordoostpolder, Oudewater, Terschelling, Urk (2x), Vianen, Vlieland en Woerden is de provincie gewijzigd.\r\n\r\nWijzigingen van provincie sinds 1830:\r\nLeimuiden overgegaan van Noord-Holland naar Zuid-Holland in 1864\r\nNoordoostpolder overgegaan van Overijssel naar Flevoland op 1 januari 1986\r\nOudewater overgegaan van Zuid-Holland naar Utrecht op 1 september 1970\r\nTerschelling overgegaan van Noord-Holland naar Fryslân op 1 september 1942\r\nUrk overgegaan van Noord-Holland naar Overijssel op 1 april 1950\r\nUrk overgegaan van Overijssel naar Flevoland op 1 januari 1986\r\nVianen overgegaan van Zuid-Holland naar Utrecht op 1 januari 2002\r\nVlieland overgegaan van Noord-Holland naar Fryslân op 1 september 1942\r\nWoerden overgegaan van Zuid-Holland naar Utrecht op 1 januari 1989\r\nBovengenoemde gemeenten zijn in de tabel ingedeeld bij de huidige\r\nprovincie.", "Datatype": "String", "Unit": "afkorting", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 6, "Position": 6, "ParentID": null, "Type": "Topic", "Key": "BegindatumSorteerveld_6", "Title": "Begindatum (sorteerveld)", "Description": "Datum van ontstaan van de gebieds- of gemeentenaam, daarbij is de datumnotatie jaar maand dag. Indien ontstaan voor 1830 is de datum op 18300101 gezet.", "Datatype": "String", "Unit": "datum", "Decimals": 0, "Default": "Zero", "PresentationType": ""}, {"odata.type": "Cbs.OData.Topic", "ID": 7, "Position": 7, "ParentID": null, "Type": "Topic", "Key": "EinddatumSorteerveld_7", "Title": "Einddatum (sorteerveld)", "Description": "Einddatum van de gebieds- of gemeentenaam, daarbij is de datumnotatie jaar maand dag. Als het gebied nog bestaat dan staat hier niets.", "Datatype": "String", "Unit": "datum", "Decimals": 0, "Default": "Zero", "PresentationType": ""}]}

