== chart 675: 10000 rows; columns ['Zone', 'Milieu', 'Sexe', "Titre de l'indicateur", "Valeur de l'indicateur"]
  query: SELECT COALESCE(libelle_fr, '') || COALESCE(' -> ' || libelle_prov, '') || COALESCE(' -> ' || libelle_commune, '') AS "Zone", "Milieu" AS "Milieu", "Sexe" AS "Sexe", "Titre de l'indicateur" AS "Titre de l'indicateur", SUM("Value(valeur indicateur)") AS "Valeur de l'indicateur" FROM public."TAB_VF_LANGUES_MATERNELLES_CHECKED" GROUP BY COALESCE(libelle_fr, '') || COALESCE(' -> ' || libelle_prov, '') || COALESCE(' -> ' || libelle_commune, ''), "Milieu", "Sexe", "Titre de l'indicateur" ORDER BY "Valeur de l'indicateur" DESC LIMIT 10000;
