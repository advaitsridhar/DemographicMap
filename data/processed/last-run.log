	function getfmt(lsou) {
		var lrtn = "";
		var lsou2 = getInt(lsou);
		if (lsou2 <= 0) {
			return "";
		} else if (lsou2 > 1000000) {
			return getInt(lsou / 10000) + '年' + (getInt(lsou / 100) % 100) + '月' + (lsou % 100) + '日';
		} else {
			if (lsou % 100 == 0) {
				return getInt(lsou / 100) + '年';
			} else {
				return getInt(lsou / 100) + '年' + (lsou % 100) + '月';
			}
		}
	}


	function linkreprot(lkind, ltype, lrptid, lrptnm) {
		var lurl = ltype + lrptid;
		var ldate = new Date();
		if (lkind <= 1) {
			lurl += ".xlsx";
		} else {
			lurl += ".ods";
		}
		lurl += "?r=" + (ldate.getTime() % 100000 + ldate.getMilliseconds() * 100);
		getAjax(1, gMainPgm + "?sys=99981&kind=" + (lkind + 5) + "&cycle=1&funid=" + lurl + "&funnm=" + lrptnm, "");
		var subwin = window.open("report/" + lurl, "_blank");

	}
	function resize1() {

		const $mainbox = $(".mainbox");
		const windowWidth = window.innerWidth;
		if (windowWidth < 768) {
			// 小於 md：移除高度
			$mainbox.css("height", "");
		} else {
			// 否則設定高度
			$mainbox.height(window.innerHeight - $mainbox.position().top - 30);
		}
	}
	$(window).resize(function () {
		resize1();
	});

