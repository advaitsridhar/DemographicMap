ion and ethnicity, economics, information and communication technology, and health. ", "num_resources": 2, "num_tags": 3, "organization": {"id": "c992be95-fd4c-455c-ae9c-a20843aa2a1e", "name": "us-census-bureau", "title": "U.S. Census Bureau", "type": "organization", "description": "The Census Bureau's mission is to serve as the nation\u2019s leading provider of quality data about its people and economy. Find additional international data at https://www.census.gov/geographies/mapping-files/time-series/demo/international-programs/subnationalpopulation.html.", "image_url": "", "created": "2021-09-10T03:53:10.499105", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "c992be95-fd4c-455c-ae9c-a20843aa2a1e", "package_creator": "census-bureau-international-programs-center", "pageviews_last_14_days": 14, "private": false, "qa_completed": false, "solr_additions": "{\"countries\": [\"Bangladesh\"]}", "state": "active", "subnational": "1", "title": "Bangladesh Subnational Population and Housing Data Tables with Administrative Boundaries, Based on National Censuses and Surveys", "total_res_downloads": 559, "type": "dataset", "url": null, "version": null, "groups": [{"description": "test", "display_name": "Bangladesh", "id": "bgd", "image_display_url": "", "name": "bgd", "title": "Bangladesh"}], "resources": [{"alt_url": "https://data.humdata.org/dataset/862d607b-a195-4f69-b0cb-bd2fe6ac858f/resource/b01a071f-f35a-4a6a-adc4-b01b25ef8902/download/", "cache_last_updated": null, "cache_url": null, "created": "2022-07-26T18:10:48.847163", "datastore_active": false, "description": "National and subnational boundary feature classes of Bangladesh for joining (linking) to attribute data provided in tables prepared by the U.S. Census Bureau.", "download_url": "https://data.humdata.org/dataset/862d607b-a195-4f69-b0cb-bd2fe6ac858f/resource/b01a071f-f35a-4a6a-adc4-b01b25ef8902/download/bangladesh.gdb.zip", "format": "Geodatabase", "hash": "", "hdx_rel_