// Función para manejar el evento submit de cualquier formulario
function setTimeoutDownload(e) {
   
    //e.preventDefault();
    let formulario = e.target;
    let botonDescarga = formulario.querySelector('.descarga'); 
    let contadorElemento = formulario.querySelector('.contador'); 

    
    botonDescarga.disabled = true;
    contadorElemento.style.display = 'block';

    let tiempoRestante = 30;
    contadorElemento.innerText = 'Espera ' + tiempoRestante + ' segundos para volver a descargar...';

    let intervalo = setInterval(function() {
        tiempoRestante--;
        contadorElemento.innerText = 'Espera ' + tiempoRestante + ' segundos para volver a descargar...';

        if (tiempoRestante <= 0) {
            clearInterval(intervalo);
            contadorElemento.style.display = 'none';
        }
    }, 1000);

    setTimeout(() => {
        botonDescarga.disabled = false;
    }, 30000);
}

document.getElementById('form1').addEventListener('submit', setTimeoutDownload);
document.getElementById('form2').addEventListener('submit', setTimeoutDownload);
    </script>
