		/* === Barre d’annonce 75ème IHSI === */
.announcement-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(90deg, #00105F, #0041a8);
  color: white;
  z-index: 9999;
  padding: 6px 12px; /* réduit pour affiner la barre */
  box-shadow: 0 -2px 8px rgba(0,0,0,0.25);
  border-top: 2px solid #ab0032; /* fine bordure rouge institutionnelle */
}

.announcement-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.announcement-content audio {
  height: 26px; /* plus petit */
}

.announcement-text {
  font-size: 0.9rem; /* texte légèrement réduit */
  font-weight: 500;
}

.btn-annonce {
  background: #fff;
  color: #00105F;
  border-radius: 40px;
  padding: 6px 16px; /* bouton plus compact */
  font-size: 0.9rem;
  font-weight: bold;
  text-decoration: none;
  transition: all 0.3s ease;
}

.btn-annonce:hover {
  background: #f0f0f0;
  color: #0041a8;
}
/* === FIN: Barre d’annonce 75ème IHSI === */

	</style>
