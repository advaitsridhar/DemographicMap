: 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 6, "Position": 5, "ParentID": 2, "Type": "Topic", "Key": "ProtestantseKerkInNederland_4", "Title": "Protestantse Kerk in Nederland", "Description": "Het percentage personen dat zich rekent tot de Protestantse Kerk in Nederland. Per 1 mei 2004 is de zogeheten Protestantse Kerk in Nederland (PKN) ontstaan als gevolg van een fusie van de Nederlandse Hervormde kerk, de gereformeerde kerken en de evangelisch-lutherse kerk. In de vragenlijst is de PKN als aparte categorie toegevoegd. Omdat bleek dat niet alle leden van de oorspronkelijke gezindten zich met de PKN identificeren is besloten om zowel de oorspronkelijke gezindten waartoe de mensen zich (nog steeds) bekennen als de nieuwe PKN weer te geven. ", "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 7, "Position": 6, "ParentID": 2, "Type": "Topic", "Key": "NederlandsHervormd_5", "Title": "Nederlands Hervormd", "Description": "Het percentage personen dat zich rekent tot de Nederlandse Hervormde kerk.", "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 8, "Position": 7, "ParentID": 2, "Type": "Topic", "Key": "Gereformeerd_6", "Title": "Gereformeerd", "Description": "Het percentage personen dat zich rekent tot een van de gereformeerde kerkgenootschappen.\r\n", "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 9, "Position": 8, "ParentID": 2, "Type": "Topic", "Key": "Islam_7", "Title": "Islam", "Description": "Het percentage personen dat zich rekent tot de Islam.", "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 10, "Position": 9, "ParentID": 2, "Type": "Topic", "Key": "OverigeGezindte_8", "Title": "Overige gezindte", "Description": "Het percentage personen dat zich rekent tot een hier niet onderscheiden kerkelijke gezindte of levensbeschouwelijke groepering, waaronder joden, hindoes en boeddhisten. ", "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.TopicGroup", "ID": 11, "Position": null, "ParentID": null, "Type": "TopicGroup", "Key": "", "Title": "Bezoek religieuze dienst", "Description": "Het percentage personen dat een keer per week of vaker, twee tot drie keer per maand, een keer per maand, minder dan een keer per maand, of zelden of nooit een bijeenkomst bezoekt met een godsdienstig of levensbeschouwelijk doel.\r\nDeze gegevens hebben betrekking op personen vanaf 15 jaar.\r\nBron: EBB\r\n"}, {"odata.type": "Cbs.OData.Topic", "ID": 12, "Position": 10, "ParentID": 11, "Type": "Topic", "Key": "EenKeerPerWeekOfVaker_9", "Title": "Een keer per week of vaker", "Description": null, "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 13, "Position": 11, "ParentID": 11, "Type": "Topic", "Key": "TweeTotDrieKeerPerMaand_10", "Title": "Twee tot drie keer per maand", "Description": null, "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 14, "Position": 12, "ParentID": 11, "Type": "Topic", "Key": "EenKeerPerMaand_11", "Title": "Een keer per maand", "Description": null, "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 15, "Position": 13, "ParentID": 11, "Type": "Topic", "Key": "MinderDanEenKeerPerMaand_12", "Title": "Minder dan een keer per maand", "Description": null, "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}, {"odata.type": "Cbs.OData.Topic", "ID": 16, "Position": 14, "ParentID": 11, "Type": "Topic", "Key": "ZeldenOfNooit_13", "Title": "Zelden of nooit", "Description": null, "Datatype": "Long", "Unit": "% van de bevolking", "Decimals": 0, "Default": "Impossible", "PresentationType": "Relative"}]}

