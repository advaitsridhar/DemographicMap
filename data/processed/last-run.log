(function() {
    'use strict';
    
    angular
    .module('censo')
    .controller('DoctosController', doctosController)
    .component('doctos', {
        templateUrl: '/js/app/components/doctos/doctos.html',
        controller: 'DoctosController',
        controllerAs: 'vmDoctos',
        bindings: {
            docs : '=',
            search: "="
        }
    });
    
    
    doctosController.$inject = [
        '$scope',
        '$rootScope'
    ];
    
    function doctosController($scope, $rootScope) {
        
        var vm = this;
        
        vm.$onInit = onInit;
        
        function onInit(){
            
            vm.cargaDocumentos = cargaDocumentos;
        } 
        
        function cargaDocumentos(){
            $scope.data=[vm.docs]
            
            $scope.dataTableOpt = {
                "aLengthMenu": [[10, 50, 100,-1], [10, 50, 100,'All']],
            };   
        }    
        
        
    }
})();
