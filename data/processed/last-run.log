== chart 674: 3 rows; columns ['Milieu ', 'Indice synthétique de fécondité']
  query: SELECT "Milieu " AS "Milieu ", SUM("ISF") AS "Indice synthétique de fécondité" FROM public."POP6" GROUP BY "Milieu " ORDER BY "Indice synthétique de fécondité" DESC LIMIT 10000;
== chart 676: 4878 rows; columns ['Zone', "Type d'établissement", 'Nombre des établissements']
  query: SELECT COALESCE(NULLIF(libelle_region, ''), 'Royaume du Maroc') || COALESCE(' -> ' || libelle_province, '') || COALESCE(' -> ' || libelle_commune, '') AS "Zone", types_ebl AS "Type d'établissement", SUM(valeurs) AS "Nombre des établissements" FROM public.cee_ets GROUP BY COALESCE(NULLIF(libelle_region, ''), 'Royaume du Maroc') || COALESCE(' -> ' || libelle_province, '') || COALESCE(' -> ' || libelle_commune, ''), types_ebl ORDER BY "Nombre des établissements" DESC LIMIT 10000;
