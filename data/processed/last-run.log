  5,276 bytes
(function() {
    'use strict';
    
    angular
    .module('censo')
    .controller('ExploradorController', exploradorController)
    .component('explorador', {
        templateUrl: '/js/app/components/explorador/explorador.html',
        controller: 'ExploradorController',
        controllerAs: 'vmExplorador',
        bindings: {        
        }
    });
    
    exploradorController.$inject = [
        '$scope',
        '$http',
        'ngIntroService'
    ];
    
    function exploradorController($scope, $http, ngIntroService) {
        
        var vm = this;
        
        vm.$onInit = $onInit();
        
        function $onInit(){ 
            
            vm.cargaInicial = cargaInicial;
            vm.findDocs = findDocs;
                       
            cargaInicial();
        }


        $scope.IntroOptions = {
            steps:[
                {
                    element: document.querySelector('#step101'),
                    intro: "<strong>Área temática</strong><br>Permite filtrar los documentos por persona, hogar y vivienda.<br>Al seleccionar <strong>Todos</strong> se muestra la totalidad de documentos, con opción a descargarse en formato Microsoft Excel.",
                    position: 'right'
                },
                {
                    element: '#step102',
                    intro: '<strong>Búsqueda</strong><br>Muestra únicamente los documentos que contienen alguna de las frases y/o palabras claves ingresadas en el cuadro de búsqueda. <br>Las palabras claves van separadas por coma (,) cuando dese utilizar más de una.',
                    position: 'left'
                }
                
            ],
            showStepNumbers: false,
            showBullets: false,
            exitOnOverlayClick: true,
            exitOnEsc:true,
            prevLabel: '<span style="color:white">Anterior</span>',
            nextLabel: 'Siguiente',
            skipLabel: 'Cerrar',
            doneLabel: 'Cerrar'
        };
        
        $scope.CompletedEvent = function(){
            console.log('[directive] completed Event')
        }
        $scope.ExitEvent= function(){
            console.log('[directive] exit Event')
        }
        $scope.ChangeEvent = function(){
            console.log('[directive] change Event')
        }
        $scope.BeforeChangeEvent= function(){
            console.log('[directive] beforeChange Event')
        }
        $scope.AfterChangeEvent= function(){
            console.log('[directive] after change Event')
        }
        $scope.clearAndStartNewIntro = function(){
            
            ngIntroService.clear();
            ngIntroService.setOptions($scope.IntroOptions);
            
            ngIntroService.onComplete(function(){
                console.log('update some cookie or localstorage.')
            })
            
            ngIntroService.onExit(function(){
                console.log("[service] exit");
            })
            
            ngIntroService.onBeforeChange(function(){
                console.log("[service] before change");
            })
            
            ngIntroService.onChange(()=>{
                console.log("[service] on change");
            })
            
            ngIntroService.onAfterChange(()=>{
                console.log("[service] after Change");
            })
            
            ngIntroService.start();
        }

        
        function cargaInicial(){
            $http.get('/filtros/new_filtros')
            .then(function (response){
                vm.filtro = response.data;
                vm.temag = vm.filtro.temas[0];
                findDocs();
                console.log("status:" + response.status);
            }).catch(function(response) {
                console.error('Error occurred:', response.status, response.data);
            }).finally(function() {
                console.log("Task Finished.");
            });
        }
        
        function findDocs(){
            $http.get('/filtros/doctos/' + vm.temag.id)
            .then(function (response){
                vm.doctos = response.data;
                console.log("status:" + response.status);
            }).catch(function(response) {
                console.error('Error occurred:', response.status, response.data);
            }).finally(function() {
                console.log("Task Finished.");
            });
        }
        
        
        $('#censito').click(function(){
            $("#ayuda").show();
        });
        
        $('#cerrarAyuda').click(function(){
            $("#ayuda").hide();
        });
        
        $('#navegacionSitio').click(function(){
            $("#ayuda").hide();  
        });
        
        var divAyuda = document.getElementById('ayuda');
        var eCensito = document.getElementById('eCensito');
        document.addEventListener("click", function(e){
            var clic = e.target;
            if(clic != divAyuda && clic!=eCensito){
                divAyuda.style.display = "none";
            }
        });
        
        $('#eCensito').popover();
        
    }
})();
